{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ponder",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "pages_build_output_dir": ".open-next"
}
