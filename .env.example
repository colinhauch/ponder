# Environment Configuration Example
# Copy this file to .env.local for local development

# LOCAL DEVELOPMENT (recommended)
# Use these values when running Supabase locally via Docker
# Start local Supabase with: npm run supabase:start
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Local service role key (default for all local Supabase instances)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# PRODUCTION
# Get these from your Supabase project settings > API
# https://app.supabase.com/project/_/settings/api
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVICE ROLE KEY (optional, for scripts)
# Used by import scripts to bypass RLS policies
# Keep this secret! Never commit to git or expose to client-side code
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
